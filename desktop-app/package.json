{
  "name": "ai-memory-engine-desktop",
  "version": "1.0.0",
  "description": "AI Memory Engine — Cross-platform Desktop App",
  "main": "src/main/electron.js",
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"npm run electron-wait\"",
    "vite": "vite",
    "electron": "electron .",
    "electron-wait": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.faisalnavy.memory-engine",
    "productName": "AI Memory Engine",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "homepage": "./",
  "allowScripts": {
    "core-js@3.49.0": true,
    "core-js-pure@3.49.0": true,
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
