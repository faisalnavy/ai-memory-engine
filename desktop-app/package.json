{
  "name": "ai-memory-engine-desktop",
  "version": "1.0.0",
  "description": "AI Memory Engine — Cross-platform Desktop App",
  "main": "src/main/electron.js",
  "scripts": {
    "start":   "concurrently \"npm run react\" \"npm run electron-wait\"",
    "react":   "react-scripts start",
    "electron": "electron .",
    "electron-wait": "wait-on http://localhost:3000 && electron .",
    "build":   "react-scripts build && electron-builder",
    "pack":    "electron-builder --dir"
  },
  "dependencies": {
    "react":        "^18.2.0",
    "react-dom":    "^18.2.0",
    "react-scripts": "5.0.1",
    "axios":        "^1.6.0",
    "recharts":     "^2.10.0"
  },
  "devDependencies": {
    "electron":         "^28.0.0",
    "electron-builder": "^24.0.0",
    "concurrently":     "^8.0.0",
    "wait-on":          "^7.0.0",
    "@types/react":     "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript":       "^5.3.0"
  },
  "build": {
    "appId": "com.faisalnavy.memory-engine",
    "productName": "AI Memory Engine",
    "directories": { "output": "dist-electron" },
    "files": ["build/**/*", "src/main/**/*", "node_modules/**/*"],
    "win":   { "target": "nsis", "icon": "public/icon.ico" },
    "mac":   { "target": "dmg",  "icon": "public/icon.icns" },
    "linux": { "target": "AppImage", "icon": "public/icon.png" }
  },
  "homepage": "./"
}
